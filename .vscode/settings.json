{
  "rust-analyzer.server.path": "rust-analyzer",
  "rust-analyzer.cargo.buildScripts.overrideCommand": [
    "cargo",
    "check",
    "--release",
    "--workspace",
    "--all-targets",
    "--message-format=json",
    "--locked",
    "--keep-going"
