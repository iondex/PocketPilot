{
  "display_information": {
    "name": "PocketPilot",
    "description": "Manage your shared Codex sessions in direct messages"
  },
  "features": {
    "bot_user": {
      "display_name": "PocketPilot",
      "always_online": false
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:history",
        "im:write",
        "files:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "interactivity": {
      "is_enabled": true
    },
    "event_subscriptions": {
      "bot_events": [
        "message.im"
      ]
    },
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
